import numpy as np 
import pandas as pd
import matplotlib.pyplot as plt 


df= pd.read_csv("Practice.csv")
df


df['Discounted Price']= df['Price'] - df['Price']* 0.1
df


df.to_csv('discounted_products.csv', index=False)


df


df.duplicated(subset=['EmployeeID']).sum()


df.drop_duplicates(subset= ['EmployeeID'],inplace= True)


df


df[['Age',"Salary"]].isnull().sum()


df['Age']=df['Age'].fillna(df['Age'].mean())


df


df.dropna(subset=['Salary'],inplace=True)


avg= df.iloc[::,5:8].mean()


avg


mx= df.iloc[::,5:8].max()


mx


df['Total Marks']= df[['Marks1','Marks2','Marks3']].sum(axis=1)


df


sd= df['Total Marks'].std()


print(sd)


plt.hist(df['Age'], edgecolor='black')

plt.title('Distribution of Age')
plt.xlabel('Age')
plt.ylabel('Frequency')

plt.show()


plt.scatter(df['Price'],df['Discounted Price'],color= 'pink', marker='o')
plt.title('Distribution of Price vs Discounted Price')
plt.xlabel('Price')
plt.ylabel('Discounted Price')

plt.show()


plt.scatter(df['Age'],df['Salary'],color= 'red', marker='o')
plt.title('Distribution of Age vs Salary')
plt.xlabel('Age')
